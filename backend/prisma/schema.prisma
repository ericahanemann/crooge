generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  // Nullable: a Google-only account never sets one. `POST /sessions`
  // (password login) must check for null rather than let `argon2.verify`
  // run against it — see `authenticate-session.ts`. The profile page can
  // let a Google-only user set a password later (adding a second sign-in
  // method); nothing currently stops the reverse (a password account
  // staying password-only forever).
  password      String?
  // Google's stable subject id (`sub` claim) — set the first time a
  // `POST /sessions/google` call resolves to this account, whether that's
  // a brand-new account or an existing password account being linked.
  // Unique so one Google identity can't end up attached to two local
  // accounts.
  googleId      String?        @unique @map("google_id")
  // Google's own picture URL — set automatically the first time a Google
  // sign-in/link resolves for this user and it doesn't already have one.
  // There's no way to set this by hand; null for an account that's never
  // signed in with Google, or whose Google account has no picture.
  avatarUrl     String?        @map("avatar_url")
  // Account-scoped preferences — a write-through cache of these also lives
  // in cookies on the frontend domain (theme/color-theme/NEXT_LOCALE) so
  // first paint stays flash-free with no network round trip; this row is
  // the source of truth they reconcile from on sign-in/refresh. Plain
  // strings (not Prisma enums) since the allowed set is a frontend/UX
  // concern that can grow without a migration — Zod validates the allowed
  // values at the API boundary instead, same division of labor as
  // `iconKeySchema` for categories.
  locale        String         @default("en")
  theme         String         @default("dark")
  colorTheme    String         @default("pink") @map("color_theme")
  // Display-only — changes formatting, never converts stored amounts.
  currency      String         @default("BRL")
  // Whole percent (0-100) of income treated as savings rather than budget,
  // e.g. `budget = income * (1 - savingsRate / 100)`. Defaults to 0, which
  // makes budget == income — today's behavior, unchanged until a user
  // opts in.
  savingsRate   Int            @default(0) @map("savings_rate")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  refreshTokens RefreshToken[]
  transactions  Transaction[]
  creditCards   CreditCard[]
  categories    Category[]
  recurringSeries RecurringSeries[]

  @@map("users")
}

/**
 * Failed-attempt counter behind login/reauth lockout (see
 * `modules/auth/lockout.ts`). `key` is whatever identifies the thing being
 * brute-forced — the lowercased email presented to `POST /sessions`, or
 * `user:<id>` for an already-authenticated reauth check (`PATCH
 * /me/password`, `DELETE /me`) — deliberately not a FK to `User`: tracking
 * by the presented key rather than a resolved account id means a key that
 * doesn't resolve to a real account locks out identically to one that
 * does, so this can't be used to probe which emails/accounts exist (same
 * reasoning as `authenticate-session.ts`'s dummy-hash timing fix).
 */
model AuthAttempt {
  key         String    @id
  failedCount Int       @default(0) @map("failed_count")
  lockedUntil DateTime? @map("locked_until")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("auth_attempts")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique @map("token_hash")
  familyId  String    @map("family_id")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionTiming {
  ONE_TIME
  INSTALLMENT
  RECURRING
}

enum PaymentMethod {
  DEBIT_PIX
  CREDIT
}

enum RecurringFrequency {
  MONTHLY
  ANNUAL
}

enum CardBrand {
  VISA
  MASTERCARD
  AMEX
  ELO
}

model Transaction {
  id                 String              @id @default(uuid())
  userId             String              @map("user_id")
  user               User                @relation(fields: [userId], references: [id])
  type               TransactionType
  category           String
  description        String
  amount             Decimal             @db.Decimal(12, 2)
  date               DateTime            @db.Date
  timing             TransactionTiming   @default(ONE_TIME)
  paymentMethod      PaymentMethod?      @map("payment_method")
  installmentCurrent Int?                @map("installment_current")
  installmentTotal   Int?                @map("installment_total")
  /// Installments only, going forward — shared by every row of one installment purchase. Recurring series use `recurringSeriesId` instead.
  groupId            String?             @map("group_id")
  creditCardId       String?             @map("credit_card_id")
  creditCard         CreditCard?         @relation(fields: [creditCardId], references: [id])
  creditCardBillId   String?             @unique @map("credit_card_bill_id")
  creditCardBill     CreditCardBill?     @relation(fields: [creditCardBillId], references: [id])
  recurringSeriesId  String?             @map("recurring_series_id")
  recurringSeries    RecurringSeries?    @relation(fields: [recurringSeriesId], references: [id])
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  @@unique([recurringSeriesId, date])
  @@index([userId, date])
  @@index([creditCardId, date])
  @@index([groupId])
  @@map("transactions")
}

/**
 * The rule behind a recurring transaction (rent, a subscription, ...) — amount,
 * category, cadence, and an optional end. Occurrences are never pre-generated
 * in bulk; each is a real `Transaction` row materialized lazily, snapshotting
 * this series' fields at the moment it's created (see
 * `transactions/materialize-recurring-occurrences.ts`). Editing this row's
 * `amount`/`category`/etc. therefore only affects occurrences materialized
 * afterward — anything already materialized stays as history.
 *
 * No `type` field: only expenses can be recurring today (see
 * `incomeBodySchema` in `routes/create-transaction.ts`).
 */
model RecurringSeries {
  id            String              @id @default(uuid())
  userId        String              @map("user_id")
  user          User                @relation(fields: [userId], references: [id])
  category      String
  description   String
  amount        Decimal             @db.Decimal(12, 2)
  frequency     RecurringFrequency
  paymentMethod PaymentMethod?      @map("payment_method")
  creditCardId  String?             @map("credit_card_id")
  creditCard    CreditCard?         @relation(fields: [creditCardId], references: [id])
  startDate     DateTime            @db.Date @map("start_date")
  /// Null while active. Once set, no occurrence on or after this date is ever materialized — set by "delete from here forward" on a recurring occurrence.
  endDate       DateTime?           @db.Date @map("end_date")
  transactions  Transaction[]
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  @@index([userId])
  @@map("recurring_series")
}

model CreditCard {
  id           String           @id @default(uuid())
  userId       String           @map("user_id")
  user         User             @relation(fields: [userId], references: [id])
  name         String
  brand        CardBrand
  limit        Decimal          @db.Decimal(12, 2)
  closingDay   Int              @map("closing_day")
  dueDay       Int              @map("due_day")
  archivedAt   DateTime?        @map("archived_at")
  transactions Transaction[]
  bills        CreditCardBill[]
  recurringSeries RecurringSeries[]
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  @@index([userId])
  @@map("credit_cards")
}

model CreditCardBill {
  id           String       @id @default(uuid())
  creditCardId String       @map("credit_card_id")
  creditCard   CreditCard   @relation(fields: [creditCardId], references: [id])
  cycleMonth   String       @map("cycle_month")
  closingDate  DateTime     @map("closing_date") @db.Date
  dueDate      DateTime     @map("due_date") @db.Date
  paidAt       DateTime?    @map("paid_at")
  paidAmount   Decimal?     @map("paid_amount") @db.Decimal(12, 2)
  transaction  Transaction?

  @@unique([creditCardId, cycleMonth])
  @@index([creditCardId])
  @@map("credit_card_bills")
}

enum CategoryKind {
  EXPENSE
  INCOME
}

model Category {
  id         String       @id @default(uuid())
  userId     String       @map("user_id")
  user       User         @relation(fields: [userId], references: [id])
  kind       CategoryKind
  label      String
  icon       String       @default("tag")
  isFallback Boolean      @default(false) @map("is_fallback")
  isSystem   Boolean      @default(false) @map("is_system")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  @@unique([userId, kind, label])
  @@index([userId])
  @@map("categories")
}
